{
  "name": "hsl-map-generator-server",
  "version": "1.0.5",
  "engines": {
    "node": ">=24"
  },
  "description": "Server component for the HSL map generator",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server",
    "start:local": "bash start-local.sh",
    "watch": "nodemon src/server",
    "lint": "eslint src test --fix",
    "lint:check": "eslint src test && prettier --check \"{src,test}/**/*.js\"",
    "format": "prettier --write \"{src,test}/**/*.js\"",
    "lint:mega": "npx --yes mega-linter-runner@9 --flavor javascript --release v9.6.0",
    "lint:mega:fix": "npx --yes mega-linter-runner@9 --flavor javascript --release v9.6.0 --fix",
    "lint:mega:changed": "npx --yes mega-linter-runner@9 --flavor javascript --release v9.6.0 -e VALIDATE_ALL_CODEBASE=false",
    "test:unit": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --test-reporter=junit --test-reporter-destination=junit.xml \"test/**/*.test.js\"",
    "check-and-build": "npm run lint:check && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HSLdevcom/hsl-map-generator-server.git"
  },
  "keywords": [],
  "author": "Hannes Junnila <hannes.junnila@gmail.com>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/HSLdevcom/hsl-map-generator-server/issues"
  },
  "homepage": "https://github.com/HSLdevcom/hsl-map-generator-server",
  "devDependencies": {
    "eslint": "^8.33.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.5.7",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.3.1",
    "@mapbox/tilelive": "^6.1.1",
    "@maplibre/maplibre-gl-native": "^6.4.0",
    "@math.gl/web-mercator": "^3.6.3",
    "generic-pool": "^3.9.0",
    "koa": "^2.15.5",
    "koa-bodyparser": "^4.3.0",
    "lodash": "^4.18.1",
    "p-cancelable": "2.1.1",
    "p-every": "^2.0.0",
    "proj4": "^2.8.1",
    "request": "^2.88.2",
    "requestretry": "^7.1.0",
    "sharp": "^0.35.4",
    "string-hash": "^1.1.3"
  },
  "overrides": {
    "minimatch@^10": "^11.0.1",
    "request": {
      "form-data": "^4.0.6",
      "qs": "^6.16.0",
      "tough-cookie": "^4.1.3"
    }
  },
  "allowScripts": {
    "@maplibre/maplibre-gl-native": true
  }
}
